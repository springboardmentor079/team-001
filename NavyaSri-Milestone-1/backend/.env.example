# Copy this file to `.env` and adjust values for your environment.

# --- Database ---
# PostgreSQL (recommended for anything beyond quick local testing):
DATABASE_URL=postgresql://username:password@localhost:5432/buildtrack_db

# SQLite (zero-setup local development / demo — uncomment to use instead):
# DATABASE_URL=sqlite:///./buildtrack.db

# --- Security ---
SECRET_KEY=replace_with_secure_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# --- Frontend / CORS ---
FRONTEND_URL=http://localhost:4200

# --- General ---
ENVIRONMENT=development
