generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMINISTRATOR
  PROJECT_MANAGER
  SITE_ENGINEER
  CONTRACTOR
  WORKER
  CLIENT
}

model Organization {
  id             String          @id @default(uuid()) @db.Uuid
  name           String          @db.VarChar(160)
  currency       String          @default("INR") @db.VarChar(3)
  timezone       String          @default("Asia/Kolkata")
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  users          User[]
  projects       Project[]
  auditLogs      AuditLog[]
  equipment      Equipment[]
  materials      Material[]
  workers        WorkerProfile[]
  vendors        Vendor[]
  purchaseOrders PurchaseOrder[]
  goodsReceipts  GoodsReceipt[]
  invoices       Invoice[]
  expenses       Expense[]
  documents      Document[]
  notifications  Notification[]

  @@map("organizations")
}

model User {
  id                    String                @id @default(uuid()) @db.Uuid
  organizationId        String                @db.Uuid
  organization          Organization          @relation(fields: [organizationId], references: [id])
  name                  String                @db.VarChar(150)
  email                 String                @unique @db.VarChar(254)
  phone                 String?               @db.VarChar(30)
  passwordHash          String
  role                  Role                  @default(CLIENT)
  active                Boolean               @default(true)
  mustChangePassword    Boolean               @default(false)
  lastLoginAt           DateTime?             @db.Timestamptz(3)
  createdAt             DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime              @updatedAt @db.Timestamptz(3)
  sessions              AuthSession[]
  projectMemberships    ProjectMember[]
  workItems             WorkItem[]
  siteReports           SiteReport[]
  delays                SiteDelay[]
  inspections           Inspection[]
  equipmentAllocations  EquipmentAllocation[]
  materialRequests      MaterialRequest[]     @relation("RequestAuthor")
  materialApprovals     MaterialRequest[]     @relation("RequestApprover")
  workerProfile         WorkerProfile?
  attendanceApprovals   Attendance[]          @relation("AttendanceApprover")
  procurementRequests   ProcurementRequest[]  @relation("ProcurementRequester")
  procurementApprovals  ProcurementRequest[]  @relation("ProcurementApprover")
  purchaseOrderCreators PurchaseOrder[]       @relation("PurchaseOrderCreator")
  receiptCreators       GoodsReceipt[]        @relation("ReceiptCreator")
  expensesCreated       Expense[]             @relation("ExpenseCreator")
  expensesApproved      Expense[]             @relation("ExpenseApprover")
  documentUploads       DocumentVersion[]
  notifications         Notification[]
  resets                PasswordReset[]
  auditLogs             AuditLog[]

  @@index([organizationId, role])
  @@map("users")
}

model AuthSession {
  id               String            @id @default(uuid()) @db.Uuid
  userId           String            @db.Uuid
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshHash      String            @unique
  refreshTokenUses RefreshTokenUse[]
  expiresAt        DateTime          @db.Timestamptz(3)
  revokedAt        DateTime?         @db.Timestamptz(3)
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)

  @@index([userId, revokedAt])
  @@map("auth_sessions")
}

model RefreshTokenUse {
  id         String      @id @default(uuid()) @db.Uuid
  sessionId  String      @db.Uuid
  session    AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tokenHash  String      @unique
  consumedAt DateTime    @default(now()) @db.Timestamptz(3)

  @@index([sessionId, consumedAt])
  @@map("refresh_token_uses")
}

model PasswordReset {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@index([userId])
  @@map("password_reset_tokens")
}

model AuditLog {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  actorId        String?      @db.Uuid
  actor          User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action         String
  entity         String
  entityId       String
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)

  @@index([organizationId, createdAt])
  @@index([actorId])
  @@map("audit_logs")
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  DELAYED
  COMPLETED
  CLOSED
  CANCELLED
}

model Project {
  id                   String                    @id @default(uuid()) @db.Uuid
  organizationId       String                    @db.Uuid
  organization         Organization              @relation(fields: [organizationId], references: [id])
  code                 String                    @db.VarChar(30)
  name                 String                    @db.VarChar(150)
  description          String                    @default("") @db.VarChar(5000)
  category             String                    @db.VarChar(80)
  address              String                    @db.VarChar(300)
  city                 String                    @db.VarChar(100)
  state                String                    @db.VarChar(100)
  country              String                    @default("India") @db.VarChar(100)
  status               ProjectStatus             @default(PLANNING)
  priority             String                    @default("MEDIUM") @db.VarChar(10)
  startDate            DateTime                  @db.Date
  endDate              DateTime                  @db.Date
  budget               Decimal                   @db.Decimal(16, 2)
  estimatedCost        Decimal                   @db.Decimal(16, 2)
  notes                String                    @default("") @db.VarChar(5000)
  createdAt            DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                  @updatedAt @db.Timestamptz(3)
  members              ProjectMember[]
  workItems            WorkItem[]
  siteReports          SiteReport[]
  delays               SiteDelay[]
  inspections          Inspection[]
  equipmentAllocations EquipmentAllocation[]
  materialRequests     MaterialRequest[]
  workerAssignments    WorkerProjectAssignment[]
  attendance           Attendance[]
  shifts               Shift[]
  procurementRequests  ProcurementRequest[]
  budgetAllocations    BudgetAllocation[]
  expenses             Expense[]
  documents            Document[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@map("projects")
}

model ProjectMember {
  projectId String  @db.Uuid
  userId    String  @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

enum WorkKind {
  MILESTONE
  TASK
}

enum WorkStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  DELAYED
}

model WorkItem {
  id                  String      @id @default(uuid()) @db.Uuid
  projectId           String      @db.Uuid
  project             Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind                WorkKind
  name                String      @db.VarChar(150)
  description         String      @default("") @db.VarChar(5000)
  startDate           DateTime    @db.Date
  plannedDate         DateTime    @db.Date
  actualDate          DateTime?   @db.Date
  status              WorkStatus  @default(NOT_STARTED)
  progress            Int         @default(0)
  weight              Decimal     @default(1) @db.Decimal(8, 2)
  baselineStartDate   DateTime?   @db.Date
  baselinePlannedDate DateTime?   @db.Date
  responsibleId       String?     @db.Uuid
  responsible         User?       @relation(fields: [responsibleId], references: [id], onDelete: SetNull)
  dependencyId        String?     @db.Uuid
  dependency          WorkItem?   @relation("WorkDependencies", fields: [dependencyId], references: [id], onDelete: Restrict)
  dependents          WorkItem[]  @relation("WorkDependencies")
  delays              SiteDelay[]
  version             Int         @default(1)
  createdAt           DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime    @updatedAt @db.Timestamptz(3)

  @@index([projectId, plannedDate])
  @@map("work_items")
}

model SiteReport {
  id                 String                 @id @default(uuid()) @db.Uuid
  projectId          String                 @db.Uuid
  project            Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId           String?                @db.Uuid
  author             User?                  @relation(fields: [authorId], references: [id], onDelete: SetNull)
  reportDate         DateTime               @db.Date
  weather            String                 @db.VarChar(150)
  workersPresent     Int
  workCompleted      String                 @db.VarChar(5000)
  reportedProgress   Int
  materialsUsed      String                 @default("") @db.VarChar(5000)
  equipmentUsed      String                 @default("") @db.VarChar(5000)
  safetyObservations String                 @default("") @db.VarChar(5000)
  issues             String                 @default("") @db.VarChar(5000)
  notes              String                 @default("") @db.VarChar(5000)
  version            Int                    @default(1)
  createdAt          DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime               @updatedAt @db.Timestamptz(3)
  attachments        SiteReportAttachment[]

  @@unique([projectId, authorId, reportDate])
  @@index([projectId, reportDate])
  @@map("site_reports")
}

model SiteReportAttachment {
  id          String     @id @default(uuid()) @db.Uuid
  reportId    String     @db.Uuid
  report      SiteReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  filename    String     @db.VarChar(255)
  mimeType    String     @db.VarChar(120)
  size        Int
  storagePath String     @db.VarChar(500)
  checksum    String     @db.VarChar(64)
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)

  @@index([reportId, createdAt])
  @@map("site_report_attachments")
}

enum DelayStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
}

model SiteDelay {
  id               String      @id @default(uuid()) @db.Uuid
  projectId        String      @db.Uuid
  project          Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reporterId       String?     @db.Uuid
  reporter         User?       @relation(fields: [reporterId], references: [id], onDelete: SetNull)
  workItemId       String?     @db.Uuid
  workItem         WorkItem?   @relation(fields: [workItemId], references: [id], onDelete: SetNull)
  date             DateTime    @db.Date
  cause            String      @db.VarChar(500)
  daysDelayed      Int
  impact           String      @db.VarChar(3000)
  correctiveAction String      @default("") @db.VarChar(3000)
  critical         Boolean     @default(false)
  status           DelayStatus @default(OPEN)
  version          Int         @default(1)
  createdAt        DateTime    @default(now()) @db.Timestamptz(3)

  @@index([projectId, status])
  @@map("site_delays")
}

enum InspectionResult {
  PASSED
  CONDITIONAL
  FAILED
}

model Inspection {
  id               String           @id @default(uuid()) @db.Uuid
  projectId        String           @db.Uuid
  project          Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  inspectorId      String?          @db.Uuid
  inspector        User?            @relation(fields: [inspectorId], references: [id], onDelete: SetNull)
  date             DateTime         @db.Date
  location         String           @db.VarChar(300)
  type             String           @db.VarChar(100)
  result           InspectionResult
  findings         String           @db.VarChar(5000)
  correctiveAction String           @default("") @db.VarChar(3000)
  resolved         Boolean          @default(false)
  version          Int              @default(1)
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)

  @@index([projectId, resolved])
  @@map("inspections")
}

enum EquipmentStatus {
  AVAILABLE
  IN_USE
  RESERVED
  MAINTENANCE
  UNAVAILABLE
}

model Equipment {
  id                  String                @id @default(uuid()) @db.Uuid
  organizationId      String                @db.Uuid
  organization        Organization          @relation(fields: [organizationId], references: [id])
  code                String                @db.VarChar(40)
  name                String                @db.VarChar(150)
  type                String                @db.VarChar(100)
  location            String                @db.VarChar(200)
  status              EquipmentStatus       @default(AVAILABLE)
  hourlyRate          Decimal               @default(0) @db.Decimal(12, 2)
  commissionedAt      DateTime?             @db.Date
  serviceIntervalDays Int                   @default(90)
  notes               String                @default("") @db.VarChar(3000)
  active              Boolean               @default(true)
  version             Int                   @default(1)
  createdAt           DateTime              @default(now()) @db.Timestamptz(3)
  allocations         EquipmentAllocation[]
  maintenance         MaintenanceRecord[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@map("equipment")
}

model EquipmentAllocation {
  id          String    @id @default(uuid()) @db.Uuid
  equipmentId String    @db.Uuid
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  projectId   String    @db.Uuid
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  operatorId  String?   @db.Uuid
  operator    User?     @relation(fields: [operatorId], references: [id], onDelete: SetNull)
  startAt     DateTime  @db.Timestamptz(3)
  endAt       DateTime  @db.Timestamptz(3)
  releasedAt  DateTime? @db.Timestamptz(3)
  notes       String    @default("") @db.VarChar(2000)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  @@index([equipmentId, startAt, endAt])
  @@index([projectId])
  @@map("equipment_allocations")
}

enum MaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model MaintenanceRecord {
  id             String            @id @default(uuid()) @db.Uuid
  equipmentId    String            @db.Uuid
  equipment      Equipment         @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  type           String            @db.VarChar(120)
  scheduledAt    DateTime          @db.Timestamptz(3)
  completedAt    DateTime?         @db.Timestamptz(3)
  failureRelated Boolean           @default(false)
  downtimeHours  Decimal           @default(0) @db.Decimal(10, 2)
  priority       String            @db.VarChar(20)
  status         MaintenanceStatus @default(SCHEDULED)
  notes          String            @default("") @db.VarChar(3000)
  version        Int               @default(1)
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)

  @@index([equipmentId, status, scheduledAt])
  @@map("maintenance_records")
}

model Material {
  id                  String               @id @default(uuid()) @db.Uuid
  organizationId      String               @db.Uuid
  organization        Organization         @relation(fields: [organizationId], references: [id])
  sku                 String               @db.VarChar(50)
  name                String               @db.VarChar(150)
  category            String               @db.VarChar(100)
  unit                String               @db.VarChar(30)
  currentStock        Decimal              @default(0) @db.Decimal(16, 3)
  allocatedStock      Decimal              @default(0) @db.Decimal(16, 3)
  minimumLevel        Decimal              @default(0) @db.Decimal(16, 3)
  criticalLevel       Decimal              @default(0) @db.Decimal(16, 3)
  unitCost            Decimal              @default(0) @db.Decimal(16, 2)
  supplier            String               @default("") @db.VarChar(160)
  active              Boolean              @default(true)
  version             Int                  @default(1)
  createdAt           DateTime             @default(now()) @db.Timestamptz(3)
  requests            MaterialRequest[]
  movements           StockMovement[]
  procurementRequests ProcurementRequest[]
  purchaseOrders      PurchaseOrder[]

  @@unique([organizationId, sku])
  @@index([organizationId, category])
  @@map("materials")
}

enum WorkerStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}

model WorkerProfile {
  id             String                    @id @default(uuid()) @db.Uuid
  organizationId String                    @db.Uuid
  organization   Organization              @relation(fields: [organizationId], references: [id])
  userId         String?                   @unique @db.Uuid
  user           User?                     @relation(fields: [userId], references: [id], onDelete: SetNull)
  employeeCode   String                    @db.VarChar(40)
  name           String                    @db.VarChar(150)
  category       String                    @db.VarChar(100)
  phone          String                    @default("") @db.VarChar(30)
  hourlyRate     Decimal                   @default(0) @db.Decimal(12, 2)
  status         WorkerStatus              @default(ACTIVE)
  active         Boolean                   @default(true)
  version        Int                       @default(1)
  createdAt      DateTime                  @default(now()) @db.Timestamptz(3)
  assignments    WorkerProjectAssignment[]
  attendance     Attendance[]
  shifts         Shift[]

  @@unique([organizationId, employeeCode])
  @@index([organizationId, status])
  @@map("worker_profiles")
}

model WorkerProjectAssignment {
  id        String        @id @default(uuid()) @db.Uuid
  workerId  String        @db.Uuid
  worker    WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)
  projectId String        @db.Uuid
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  startDate DateTime      @db.Date
  endDate   DateTime?     @db.Date
  role      String        @db.VarChar(100)
  createdAt DateTime      @default(now()) @db.Timestamptz(3)

  @@index([workerId, startDate, endDate])
  @@index([projectId])
  @@map("worker_project_assignments")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LEAVE
}

model Attendance {
  id           String           @id @default(uuid()) @db.Uuid
  workerId     String           @db.Uuid
  worker       WorkerProfile    @relation(fields: [workerId], references: [id], onDelete: Cascade)
  projectId    String           @db.Uuid
  project      Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workDate     DateTime         @db.Date
  status       AttendanceStatus
  hours        Decimal          @default(0) @db.Decimal(5, 2)
  approved     Boolean          @default(false)
  approvedById String?          @db.Uuid
  approvedBy   User?            @relation("AttendanceApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  notes        String           @default("") @db.VarChar(1000)
  version      Int              @default(1)
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)

  @@unique([workerId, projectId, workDate])
  @@index([projectId, workDate])
  @@map("attendance")
}

model Shift {
  id        String        @id @default(uuid()) @db.Uuid
  workerId  String        @db.Uuid
  worker    WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)
  projectId String        @db.Uuid
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  startAt   DateTime      @db.Timestamptz(3)
  endAt     DateTime      @db.Timestamptz(3)
  location  String        @default("") @db.VarChar(200)
  notes     String        @default("") @db.VarChar(1000)
  version   Int           @default(1)
  createdAt DateTime      @default(now()) @db.Timestamptz(3)

  @@index([workerId, startAt, endAt])
  @@index([projectId, startAt])
  @@map("shifts")
}

enum MaterialRequestStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  ALLOCATED
  FULFILLED
}

model MaterialRequest {
  id           String                @id @default(uuid()) @db.Uuid
  projectId    String                @db.Uuid
  project      Project               @relation(fields: [projectId], references: [id], onDelete: Restrict)
  materialId   String                @db.Uuid
  material     Material              @relation(fields: [materialId], references: [id], onDelete: Restrict)
  requesterId  String?               @db.Uuid
  requester    User?                 @relation("RequestAuthor", fields: [requesterId], references: [id], onDelete: SetNull)
  approvedById String?               @db.Uuid
  approvedBy   User?                 @relation("RequestApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  quantity     Decimal               @db.Decimal(16, 3)
  requiredDate DateTime              @db.Date
  purpose      String                @db.VarChar(1000)
  decisionNote String                @default("") @db.VarChar(1000)
  status       MaterialRequestStatus @default(DRAFT)
  version      Int                   @default(1)
  createdAt    DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime              @updatedAt @db.Timestamptz(3)
  movements    StockMovement[]

  @@index([projectId, status])
  @@index([materialId, status])
  @@map("material_requests")
}

enum StockMovementType {
  RECEIPT
  ADJUSTMENT
  ALLOCATION
  RELEASE
  ISSUE
}

model StockMovement {
  id                   String            @id @default(uuid()) @db.Uuid
  materialId           String            @db.Uuid
  material             Material          @relation(fields: [materialId], references: [id], onDelete: Restrict)
  requestId            String?           @db.Uuid
  request              MaterialRequest?  @relation(fields: [requestId], references: [id], onDelete: Restrict)
  procurementReceiptId String?           @db.Uuid
  procurementReceipt   GoodsReceipt?     @relation(fields: [procurementReceiptId], references: [id], onDelete: SetNull)
  type                 StockMovementType
  stockDelta           Decimal           @db.Decimal(16, 3)
  allocatedDelta       Decimal           @db.Decimal(16, 3)
  balanceAfter         Decimal           @db.Decimal(16, 3)
  allocatedAfter       Decimal           @db.Decimal(16, 3)
  note                 String            @db.VarChar(1000)
  createdAt            DateTime          @default(now()) @db.Timestamptz(3)

  @@index([materialId, createdAt])
  @@map("stock_movements")
}

enum VendorStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Vendor {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  organization   Organization    @relation(fields: [organizationId], references: [id])
  code           String          @db.VarChar(40)
  name           String          @db.VarChar(160)
  contactName    String          @default("") @db.VarChar(150)
  email          String          @default("") @db.VarChar(254)
  phone          String          @default("") @db.VarChar(30)
  address        String          @default("") @db.VarChar(500)
  status         VendorStatus    @default(ACTIVE)
  version        Int             @default(1)
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  purchaseOrders PurchaseOrder[]
  invoices       Invoice[]
  expenses       Expense[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@map("vendors")
}

enum ProcurementRequestStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  ORDERED
  CANCELLED
}

model ProcurementRequest {
  id            String                   @id @default(uuid()) @db.Uuid
  projectId     String                   @db.Uuid
  project       Project                  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  materialId    String                   @db.Uuid
  material      Material                 @relation(fields: [materialId], references: [id], onDelete: Restrict)
  requesterId   String?                  @db.Uuid
  requester     User?                    @relation("ProcurementRequester", fields: [requesterId], references: [id], onDelete: SetNull)
  approvedById  String?                  @db.Uuid
  approvedBy    User?                    @relation("ProcurementApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  quantity      Decimal                  @db.Decimal(14, 3)
  requiredDate  DateTime                 @db.Date
  justification String                   @db.VarChar(2000)
  status        ProcurementRequestStatus @default(SUBMITTED)
  decisionNote  String                   @default("") @db.VarChar(1000)
  version       Int                      @default(1)
  createdAt     DateTime                 @default(now()) @db.Timestamptz(3)
  purchaseOrder PurchaseOrder?

  @@index([projectId, status])
  @@index([materialId])
  @@map("procurement_requests")
}

enum PurchaseOrderStatus {
  ISSUED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id               String              @id @default(uuid()) @db.Uuid
  organizationId   String              @db.Uuid
  organization     Organization        @relation(fields: [organizationId], references: [id])
  number           String              @db.VarChar(40)
  requestId        String              @unique @db.Uuid
  request          ProcurementRequest  @relation(fields: [requestId], references: [id], onDelete: Restrict)
  vendorId         String              @db.Uuid
  vendor           Vendor              @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  materialId       String              @db.Uuid
  material         Material            @relation(fields: [materialId], references: [id], onDelete: Restrict)
  quantity         Decimal             @db.Decimal(14, 3)
  unitPrice        Decimal             @db.Decimal(14, 2)
  taxRate          Decimal             @default(0) @db.Decimal(5, 2)
  subtotal         Decimal             @db.Decimal(16, 2)
  taxAmount        Decimal             @db.Decimal(16, 2)
  total            Decimal             @db.Decimal(16, 2)
  receivedQuantity Decimal             @default(0) @db.Decimal(14, 3)
  expectedDate     DateTime            @db.Date
  status           PurchaseOrderStatus @default(ISSUED)
  createdById      String?             @db.Uuid
  createdBy        User?               @relation("PurchaseOrderCreator", fields: [createdById], references: [id], onDelete: SetNull)
  notes            String              @default("") @db.VarChar(2000)
  version          Int                 @default(1)
  createdAt        DateTime            @default(now()) @db.Timestamptz(3)
  receipts         GoodsReceipt[]
  invoices         Invoice[]

  @@unique([organizationId, number])
  @@index([vendorId, status])
  @@map("purchase_orders")
}

model GoodsReceipt {
  id              String          @id @default(uuid()) @db.Uuid
  organizationId  String          @db.Uuid
  organization    Organization    @relation(fields: [organizationId], references: [id])
  purchaseOrderId String          @db.Uuid
  purchaseOrder   PurchaseOrder   @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  receiptNumber   String          @db.VarChar(50)
  idempotencyKey  String          @db.Uuid
  quantity        Decimal         @db.Decimal(14, 3)
  receivedAt      DateTime        @db.Timestamptz(3)
  note            String          @default("") @db.VarChar(1000)
  createdById     String?         @db.Uuid
  createdBy       User?           @relation("ReceiptCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  stockMovements  StockMovement[]

  @@unique([organizationId, receiptNumber])
  @@unique([organizationId, idempotencyKey])
  @@index([purchaseOrderId, receivedAt])
  @@map("goods_receipts")
}

enum InvoiceStatus {
  SUBMITTED
  VERIFIED
  PAID
  DISPUTED
}

model Invoice {
  id              String        @id @default(uuid()) @db.Uuid
  organizationId  String        @db.Uuid
  organization    Organization  @relation(fields: [organizationId], references: [id])
  purchaseOrderId String        @db.Uuid
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  vendorId        String        @db.Uuid
  vendor          Vendor        @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  invoiceNumber   String        @db.VarChar(60)
  invoiceDate     DateTime      @db.Date
  dueDate         DateTime      @db.Date
  amount          Decimal       @db.Decimal(16, 2)
  status          InvoiceStatus @default(SUBMITTED)
  notes           String        @default("") @db.VarChar(1000)
  version         Int           @default(1)
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)

  @@unique([organizationId, vendorId, invoiceNumber])
  @@index([purchaseOrderId, status])
  @@map("invoices")
}

model BudgetAllocation {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category  String   @db.VarChar(100)
  amount    Decimal  @db.Decimal(16, 2)
  notes     String   @default("") @db.VarChar(1000)
  version   Int      @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([projectId, category])
  @@map("budget_allocations")
}

enum ExpenseStatus {
  SUBMITTED
  APPROVED
  REJECTED
  PAID
}

model Expense {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  organization   Organization  @relation(fields: [organizationId], references: [id])
  projectId      String        @db.Uuid
  project        Project       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  vendorId       String?       @db.Uuid
  vendor         Vendor?       @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  category       String        @db.VarChar(100)
  description    String        @db.VarChar(1000)
  amount         Decimal       @db.Decimal(16, 2)
  currency       String        @db.VarChar(3)
  expenseDate    DateTime      @db.Date
  sourceRef      String?       @db.VarChar(100)
  status         ExpenseStatus @default(SUBMITTED)
  createdById    String?       @db.Uuid
  createdBy      User?         @relation("ExpenseCreator", fields: [createdById], references: [id], onDelete: SetNull)
  approvedById   String?       @db.Uuid
  approvedBy     User?         @relation("ExpenseApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  notes          String        @default("") @db.VarChar(1000)
  version        Int           @default(1)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)

  @@unique([organizationId, sourceRef])
  @@index([projectId, status, expenseDate])
  @@map("expenses")
}

model Notification {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String       @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           String       @db.VarChar(60)
  title          String       @db.VarChar(160)
  message        String       @db.VarChar(1000)
  entityType     String       @default("") @db.VarChar(60)
  entityId       String       @default("") @db.VarChar(60)
  readAt         DateTime?    @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model Document {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  organization   Organization      @relation(fields: [organizationId], references: [id])
  projectId      String            @db.Uuid
  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title          String            @db.VarChar(180)
  category       String            @db.VarChar(100)
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  versions       DocumentVersion[]

  @@index([projectId, category])
  @@map("documents")
}

model DocumentVersion {
  id           String   @id @default(uuid()) @db.Uuid
  documentId   String   @db.Uuid
  document     Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version      Int
  filename     String   @db.VarChar(255)
  mimeType     String   @db.VarChar(120)
  size         Int
  storagePath  String   @db.VarChar(500)
  checksum     String   @db.VarChar(64)
  uploadedById String?  @db.Uuid
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  @@unique([documentId, version])
  @@index([documentId, createdAt])
  @@map("document_versions")
}
