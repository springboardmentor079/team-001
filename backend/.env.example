DATABASE_URL=sqlite:///./buildtrack.db
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

CORS_ORIGINS=http://localhost:4200
FRONTEND_URL=http://localhost:4200
AUTO_CREATE_TABLES=true
ALLOW_ADMIN_SIGNUP=true

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# Leave SMTP_HOST empty for development (emails are only logged in the console).
# Example for Gmail: smtp.gmail.com / 587 / your address / an App Password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=BuildTrack <no-reply@buildtrack.local>
