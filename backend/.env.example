# ── Copy this file to .env and fill in real values ──────────────────────────
# .env is git-ignored; never commit real credentials.

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://buildtrack_user:buildtrack_pass@localhost:5432/buildtrack_db

# JWT secret — use a long random string in production
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme-super-secret-key-at-least-32-chars

# Token expiry in minutes (default 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Set to true to enable SQLAlchemy query logging
DEBUG=false

# Angular dev-server origin (for CORS)
ALLOWED_ORIGINS=["http://localhost:4200"]

# Create the first administrator securely (it prompts for the password):
# python -m app.scripts.create_admin --email admin@example.com --name "BuildTrack Admin"
